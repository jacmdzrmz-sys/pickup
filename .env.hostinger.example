# Public domain whose DNS A record points to this VPS.
DOMAIN=your-domain.example

# Paste the full PostgreSQL connection string from Supabase Dashboard > Connect.
# This is not the HTTPS NEXT_PUBLIC_SUPABASE_URL.
DATABASE_URL=postgresql://postgres:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Keep private; generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# Public Supabase project URL and publishable (formerly anon) key.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional public Mapbox token; embedded in the frontend image at build time.
NEXT_PUBLIC_MAPBOX_TOKEN=
