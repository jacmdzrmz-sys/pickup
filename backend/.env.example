# Backend Environment Variables

# Server
NODE_ENV=development
PORT=3001

# Database
# Local development only. Hostinger Compose injects DATABASE_URL from the
# Supabase PostgreSQL connection string in the repository-root .env file.
DATABASE_URL=postgresql://pickup_user:pickup_password@localhost:5432/pickup_dev

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# External APIs
MAPBOX_API_KEY=your_mapbox_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Evanston Parks Integration (to be determined)
EVANSTON_PARKS_API_URL=https://api.evanston.gov/parks
EVANSTON_PARKS_API_KEY=your_evanston_api_key_here
